{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. The Projects/**/.claude/** entry is not redundant with Projects/**: on unix tauri matches fs scope with require_literal_leading_dot, so no glob ever matches a dot component and a clone's .claude/worktrees has to be named outright.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "fs:allow-read-text-file",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-fstat",
    "fs:allow-seek",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/Projects/**" },
        { "path": "$HOME/Projects/**/.claude/**" }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "gh", "cmd": "gh", "args": true },
        { "name": "git", "cmd": "git", "args": true },
        { "name": "claude", "cmd": "claude", "args": true },
        { "name": "code", "cmd": "code", "args": true },
        { "name": "open", "cmd": "open", "args": true }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "gh", "cmd": "gh", "args": true },
        { "name": "git", "cmd": "git", "args": true },
        { "name": "claude", "cmd": "claude", "args": true },
        { "name": "code", "cmd": "code", "args": true },
        { "name": "open", "cmd": "open", "args": true }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "dialog:allow-open",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "core:tray:default",
    "core:menu:default",
    "core:image:default",
    "core:app:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize"
  ]
}
